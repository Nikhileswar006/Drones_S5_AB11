<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="quadrotor">
    <static>false</static>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <!-- Mass and Inertia Matrix J = diag[0.1, 0.1, 0.12] from Section V of the Paper -->
        <mass>1.20</mass>
        <inertia>
          <ixx>0.10</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.10</iyy>
          <iyz>0.0</iyz>
          <izz>0.12</izz>
        </inertia>
      </inertial>

      <!-- Central Fuselage -->
      <visual name="fuselage_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.18 0.07</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.18 0.25 1</ambient>
          <diffuse>0.20 0.25 0.35 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Arm 1 (+X Front-Red, Motor 1 / F1 in Fig. 1) -->
      <visual name="arm1_visual">
        <pose>0.15 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.15 0.15 1</ambient>
          <diffuse>0.95 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="rotor1_visual">
        <pose>0.28 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.2 0.2 0.85</ambient>
          <diffuse>1.0 0.3 0.3 0.85</diffuse>
        </material>
      </visual>

      <!-- Arm 2 (-Y Right, Motor 2 / F2 in Fig. 1) -->
      <visual name="arm2_visual">
        <pose>0 -0.15 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.95 1</ambient>
          <diffuse>0.2 0.6 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="rotor2_visual">
        <pose>0 -0.28 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.85 0.95 0.85</ambient>
          <diffuse>0.1 0.85 0.95 0.85</diffuse>
        </material>
      </visual>

      <!-- Arm 3 (-X Rear, Motor 3 / F3 in Fig. 1) -->
      <visual name="arm3_visual">
        <pose>-0.15 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.3 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
      <visual name="rotor3_visual">
        <pose>-0.28 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.85 0.95 0.85</ambient>
          <diffuse>0.1 0.85 0.95 0.85</diffuse>
        </material>
      </visual>

      <!-- Arm 4 (+Y Left, Motor 4 / F4 in Fig. 1) -->
      <visual name="arm4_visual">
        <pose>0 0.15 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.95 1</ambient>
          <diffuse>0.2 0.6 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="rotor4_visual">
        <pose>0 0.28 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.85 0.95 0.85</ambient>
          <diffuse>0.1 0.85 0.95 0.85</diffuse>
        </material>
      </visual>

      <!-- Body Coordinate Axes (b_x Red, b_y Green, b_z Blue - Fig. 1) -->
      <visual name="bx_axis">
        <pose>0.22 0 0.05 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.44</length></cylinder></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <visual name="by_axis">
        <pose>0 0.22 0.05 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.44</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
      <visual name="bz_axis">
        <pose>0 0 0.22 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.44</length></cylinder></geometry>
        <material><ambient>0.1 0.4 1 1</ambient><diffuse>0.1 0.4 1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
