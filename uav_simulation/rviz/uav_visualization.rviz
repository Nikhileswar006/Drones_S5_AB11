Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1.0
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: World Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1.5
      Name: World Coordinate Axes
      Radius: 0.08
      Reference Frame: world
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.8
      Name: UAV Body Frame TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Quadrotor 3D Model
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 245; 212
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Reference Trajectory Path
      Topic:
        Value: /uav/reference_path
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 75; 25
      Enabled: true
      Line Style: Billboards
      Line Width: 0.08
      Name: Actual UAV Trajectory Path
      Topic:
        Value: /uav/actual_path
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Waypoints & Trajectory Markers
      Topic:
        Value: /uav/visualization_markers
  Enabled: true
  Global Options:
    Background Color: 18; 22; 34
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24.0
      Focal Point:
        X: 7.5
        Y: 1.0
        Z: 3.5
      Name: Current View
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Yaw: -1.15
