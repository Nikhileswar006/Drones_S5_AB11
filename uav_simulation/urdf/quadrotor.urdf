<?xml version="1.0"?>
<robot name="quadrotor">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.20"/>
      <!-- Paper Section V Inertia: J = diag[0.1, 0.1, 0.12] -->
      <inertia ixx="0.10" ixy="0.0" ixz="0.0" iyy="0.10" iyz="0.0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.22 0.07"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.18 0.25 0.38 1.0"/>
      </material>
    </visual>
    <!-- Front Arm (+X) -->
    <visual>
      <origin xyz="0.16 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.32"/>
      </geometry>
      <material name="red_front">
        <color rgba="0.95 0.2 0.2 1.0"/>
      </material>
    </visual>
    <!-- Rear Arm (-X) -->
    <visual>
      <origin xyz="-0.16 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.32"/>
      </geometry>
      <material name="gray_arm">
        <color rgba="0.35 0.35 0.4 1.0"/>
      </material>
    </visual>
    <!-- Left/Right Cross Arm (Y) -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.60"/>
      </geometry>
      <material name="cyan_arm">
        <color rgba="0.1 0.75 0.95 1.0"/>
      </material>
    </visual>
  </link>
</robot>
